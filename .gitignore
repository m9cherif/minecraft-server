# Server binary and everything Fabric/Minecraft downloads at setup time
server.jar
server.jar.tmp
.fabric/
libraries/
versions/
mods/*.tmp
mods/.installed-*

# Mods pulled by setup.sh (Fabric API, Simple Voice Chat).
# The two mods that ship with this repo are force-added below.
mods/*.jar
!mods/veinminer-*.jar

# World and runtime state
world/
world_nether/
world_the_end/
logs/
crash-reports/
cache/
banned-ips.json
banned-players.json
ops.json
usercache.json
usernamecache.json
whitelist.json

# Generated configs (config/voicechat is tracked on purpose)
config/*
!config/voicechat/

# Node.js companion app (web/)
node_modules/
web/.env
npm-debug.log*
