# Copy to .env, or paste these into hPanel's environment-variable editor.
# Real environment variables always win over this file.

# ---------------------------------------------------------------- required
# Where the Minecraft server actually runs. This app only queries it; the game
# server itself does not run on web hosting (see deploy/HOSTINGER.md).
MC_HOST=203.0.113.10
MC_PORT=25565

# ---------------------------------------------------------------- display
MC_NAME=My Fabric Server
# What players type into Minecraft. Defaults to MC_HOST[:MC_PORT].
MC_ADDRESS=play.example.com

# ---------------------------------------------------------------- optional
# Hostinger sets PORT itself — leave it unset there.
# PORT=3000
STATUS_CACHE_MS=10000
STATUS_TIMEOUT_MS=5000

# ------------------------------------------------------------------ tunnel
# Off by default. Only turn this on if players cannot reach MC_HOST directly
# and you have read the tunnel section of deploy/HOSTINGER.md.
TUNNEL_ENABLED=false
# 32+ random URL-safe characters:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TUNNEL_SECRET=
# The only destination the tunnel may reach.
TUNNEL_TARGET_HOST=203.0.113.10
TUNNEL_TARGET_PORT=25565
TUNNEL_MAX_CLIENTS=100
TUNNEL_IDLE_TIMEOUT_MS=300000
